# ---------------------------------------------------------------------------
# Credentials. Never commit a filled-in copy of this file — .gitignore already
# excludes `.env`, and everything here is read from the environment at runtime.
# ---------------------------------------------------------------------------

# Word-level transcription (ElevenLabs Scribe). Optional: the local Whisper
# backend needs no key, and `autocut` needs no transcript at all.
ELEVENLABS_API_KEY=

# --- Talking heads ---------------------------------------------------------

# Voice cloning + TTS. Leave FISH_BASE_URL unset for the hosted API; point it
# at a self-hosted `tools/api_server.py` (e.g. http://localhost:8080) to run
# locally with no key. The request schema is identical either way.
FISH_API_KEY=
# FISH_BASE_URL=http://localhost:8080

# Lipsync (sync.so).
SYNC_API_KEY=

# Hosted lipsync fetches its inputs by URL rather than accepting uploads, so
# local files must be reachable. Map a local directory onto a public base URL:
# REELFORGE_PUBLIC_DIR=/srv/media
# REELFORGE_PUBLIC_BASE=https://media.example.com

# --- Generation ------------------------------------------------------------

# Image and video (FLUX, Kling, Veo). Also used to animate a still reference
# into motion before lipsync.
REPLICATE_API_TOKEN=
# REELFORGE_ANIMATE_MODEL=kwaivgi/kling-v1.6-standard

OPENAI_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
